<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- AOSP -->
  <remote name="aosp"
          fetch="https://android.googlesource.com"
          sync-c="true"
          sync-tags="false"
          review="https://android-review.googlesource.com/"
          revision="refs/tags/android-17.0.0_r1" />

  <!-- CLO -->
  <remote name="clo-la"
          fetch="https://git.codelinaro.org/clo/la"
          sync-c="true"
          sync-tags="false" />

  <default remote="clo-la"/>

  <include name="system.xml"/>
  <include name="vendor.xml"/>
  <include name="wlan.xml" />

  <!-- AOSPA -->
  <remote  name="aospa"
           fetch=".."
           review="gerrit-ssh.aospa.co"
           revision="calcite"/>

  <remote  name="bitbucket"
           fetch="https://bitbucket.org"
           revision="calcite" />

  <remote  name="blobs"
           fetch="https://github.com/ThankYouMario"
           revision="calcite" />

  <remote  name="blobs-gitlab"
           fetch="https://gitlab.com/ThankYouMario"
           revision="calcite" />

  <remote  name="github"
           fetch="https://github.com" />

  <remote  name="github-ssh"
           fetch="ssh://git@github.com" />

  <remote  name="gitlab"
           fetch="https://gitlab.com" />

  <include name="aosp.xml"/>
  <include name="aospa.xml"/>
  <include name="obsolete.xml"/>

  <!-- AOSPAAsteroids (fruity-aospa) overrides ============================= -->
  <remote name="fru"
          fetch="https://github.com/fruity-aospa"
          sync-c="true"
          sync-tags="false"
          revision="calcite" />

  <!-- Local framework, power and build fixes -->
  <remove-project name="AOSPA/android_build_soong" />
  <project path="build/soong" name="android_build_soong" remote="fru">
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <remove-project name="AOSPA/android_frameworks_base" />
  <project path="frameworks/base" name="android_frameworks_base" remote="fru" />

  <remove-project name="AOSPA/android_frameworks_native" />
  <project path="frameworks/native" name="android_frameworks_native" remote="fru" />

  <remove-project name="AOSPA/android_system_memory_lmkd" />
  <project path="system/memory/lmkd" name="android_system_memory_lmkd" remote="fru" />

  <remove-project name="AOSPA/android_vendor_qcom-opensource_power" />
  <project path="vendor/qcom/opensource/power" name="android_vendor_qcom-opensource_power" remote="fru" />

  <remove-project name="platform/vendor/opensource/data-eth" />
  <project path="vendor/qcom/opensource/data-eth" name="android_vendor_qcom_opensource_data-eth" remote="fru" revision="main">
    <linkfile dest="vendor/qcom/defs/board-defs/vendor/dataeth_dlkm_vendor_board.mk" src="dataeth_dlkm_vendor_board.mk" />
    <linkfile dest="vendor/qcom/defs/product-defs/vendor/dataeth_dlkm_vendor_product.mk" src="dataeth_dlkm_vendor_product.mk" />
  </project>

  <!-- Our platform forks (fixes: kernelscripts, dtc overlays, wlan,
       vendor bits + QCOM data/IPA bring-up) -->
  <remove-project name="platform/external/dtc" />
  <project path="external/dtc" name="android_external_dtc" remote="fru" />

  <remove-project name="AOSPA/android_hardware_qcom_wlan" />
  <project path="hardware/qcom/wlan" name="android_hardware_qcom_wlan" remote="fru" />

  <remove-project name="platform/vendor/qcom-opensource/core-utils-vendor" />
  <project path="vendor/qcom/opensource/core-utils-vendor" name="android_vendor_qcom-opensource_core-utils-vendor" remote="fru" />

  <remove-project name="platform/vendor/qcom-opensource/recovery-ext" />
  <project path="vendor/qcom/opensource/recovery-ext" name="android_vendor_qcom-opensource_recovery-ext" remote="fru" />

  <remove-project name="AOSPA/android_kernel_build" />
  <project path="device/qcom/kernelscripts" name="android_kernel_build" remote="fru" >
    <linkfile dest="vendor/qcom/build/tasks/kernel_definitions.mk" src="kernel_definitions.mk"/>
  </project>

  <remove-project name="AOSPA/android_vendor_aospa" />
  <project path="vendor/aospa" name="android_vendor_aospa" remote="fru" >
    <linkfile src="build.sh" dest="rom-build.sh" />
  </project>

  <remove-project name="AOSPA/android_device_qcom_common" />
  <project path="device/qcom/common" name="android_device_qcom_common" remote="fru" >
    <linkfile dest="vendor/qcom/build/tasks/generate_extra_images.mk" src="generate_extra_images.mk"/>
  </project>

  <remove-project name="proprietary_vendor_qcom_common" />
  <project path="vendor/qcom/common" name="proprietary_vendor_qcom_common" remote="fru" />

  <!-- sm8650 audio HALs, tracking official AOSPA calcite-8650 -->
  <project path="hardware/qcom/audio" name="AOSPA/android_hardware_qcom_audio" remote="github" revision="calcite-8650" />
  <project path="hardware/qcom-caf/sm8650/audio/agm" name="AOSPA/android_vendor_qcom_opensource_agm" remote="github" revision="calcite-8650" />
  <project path="hardware/qcom-caf/sm8650/audio/graphservices" name="AOSPA/android_vendor_qcom_opensource_audioreach-graphservices" remote="github" revision="calcite-8650" />
  <project path="hardware/qcom-caf/sm8650/audio/pal" name="android_vendor_qcom_opensource_arpal-lx" remote="fru" revision="calcite-8650" />
  <project path="hardware/qcom-caf/sm8650/audio/st-hal-ar" name="android_vendor_qcom_opensource_audio-hal_st-hal-ar" remote="fru" revision="calcite-8650" />
  <project path="hardware/qcom-caf/sm8650/data-ipa-cfg-mgr" name="android_vendor_qcom_opensource_data-ipa-cfg-mgr" remote="fru" revision="calcite-caf-sm8650" />
  <project path="hardware/qcom-caf/sm8650/dataipa" name="android_vendor_qcom_opensource_dataipa" remote="fru" revision="calcite-caf-sm8650" />
  <project path="hardware/qcom/display" name="android_hardware_qcom_display" remote="fru" revision="calcite-caf-sm8650">
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8650/Android.bp" />
  </project>

  <!-- Device bring-up: asteroids (nothing) -->
  <project path="device/nothing/asteroids" name="android_device_nothing_asteroids" remote="fru" revision="calcite-6.1" />
  <project path="vendor/nothing/asteroids" name="proprietary_vendor_nothing_asteroids" remote="fru" revision="calcite-6.1" />
  <project path="hardware/nothing" name="android_hardware_nothing" remote="fru" revision="calcite-6.1" />
  <project path="kernel/nothing/sm7635" name="android_kernel_nothing_sm7635" remote="fru" revision="calcite-6.1" />
  <project path="kernel/nothing/sm7635-modules" name="android_kernel_nothing_sm7635-modules" remote="fru" revision="calcite-6.1" />
  <project path="kernel/nothing/sm7635-devicetrees" name="android_kernel_nothing_sm7635-devicetrees" remote="fru" revision="calcite-6.1" />
  <project path="hardware/dolby" name="hardware_dolby" remote="fru" revision="calcite-6.1" />
  <project path="packages/apps/LunarisDolby" name="crdroidandroid/android_packages_apps_LunarisDolby" remote="github" revision="17.0" />

  <!-- Apps -->
  <remove-project name="AOSPA/android_packages_apps_Launcher3" />
  <project path="packages/apps/Launcher3" name="android_packages_apps_Launcher3" remote="fru" revision="calcite-6.1" />

</manifest>
