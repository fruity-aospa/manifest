<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- AOSP -->
  <remote name="aosp"
          fetch="https://android.googlesource.com"
          sync-c="true"
          sync-tags="false"
          review="https://android-review.googlesource.com/"
          revision="refs/tags/android-17.0.0_r1" />

  <!-- CLO -->
  <remote name="clo-la"
          fetch="https://git.codelinaro.org/clo/la"
          sync-c="true"
          sync-tags="false" />

  <default remote="clo-la"/>

  <include name="system.xml"/>
  <include name="vendor.xml"/>
  <include name="wlan.xml" />

  <!-- AOSPA -->
  <remote  name="aospa"
           fetch=".."
           review="gerrit-ssh.aospa.co"
           revision="calcite"/>

  <remote  name="bitbucket"
           fetch="https://bitbucket.org"
           revision="calcite" />

  <remote  name="blobs"
           fetch="https://github.com/ThankYouMario"
           revision="calcite" />

  <remote  name="blobs-gitlab"
           fetch="https://gitlab.com/ThankYouMario"
           revision="calcite" />

  <remote  name="github"
           fetch="https://github.com" />

  <remote  name="github-ssh"
           fetch="ssh://git@github.com" />

  <remote  name="gitlab"
           fetch="https://gitlab.com" />

  <include name="aosp.xml"/>
  <include name="aospa.xml"/>
  <include name="obsolete.xml"/>

  <!-- AOSPAAsteroids (fruity-aospa) overrides ============================= -->
  <remote name="fru"
          fetch="https://github.com/fruity-aospa"
          sync-c="true"
          sync-tags="false"
          revision="asteroids" />

  <!-- Our platform forks (fixes: RBE/soong, kernelscripts, dtc overlays,
       lineage compat libinput, wlan, devicesettings, vendor bits, QTI
       power HAL + QCOM data/IPA bring-up) -->
  <remove-project name="AOSPA/android_build_soong" />
  <project path="build/soong" name="android_build_soong" remote="fru" />

  <remove-project name="platform/external/dtc" />
  <project path="external/dtc" name="android_external_dtc" remote="fru" />

  <remove-project name="AOSPA/android_hardware_qcom_wlan" />
  <project path="hardware/qcom/wlan" name="android_hardware_qcom_wlan" remote="fru" />

  <remove-project name="platform/vendor/qcom-opensource/core-utils-vendor" />
  <project path="vendor/qcom/opensource/core-utils-vendor" name="android_vendor_qcom-opensource_core-utils-vendor" remote="fru" />

  <remove-project name="platform/vendor/qcom-opensource/recovery-ext" />
  <project path="vendor/qcom/opensource/recovery-ext" name="android_vendor_qcom-opensource_recovery-ext" remote="fru" />

  <remove-project name="AOSPA/android_kernel_build" />
  <project path="device/qcom/kernelscripts" name="android_kernel_build" remote="fru" />

  <remove-project name="AOSPA/android_hardware_lineage_compat" />
  <project path="hardware/lineage/compat" name="android_hardware_lineage_compat" remote="fru" />

  <remove-project name="AOSPA/android_packages_resources_devicesettings" />
  <project path="packages/resources/devicesettings" name="android_packages_resources_devicesettings" remote="fru" />

  <remove-project name="AOSPA/android_vendor_aospa" />
  <project path="vendor/aospa" name="android_vendor_aospa" remote="fru" />

  <remove-project name="AOSPA/android_vendor_qcom-opensource_power" />
  <project path="vendor/qcom/opensource/power" name="android_vendor_qcom-opensource_power" remote="fru" />

  <remove-project name="proprietary_vendor_qcom_common" />
  <project path="vendor/qcom/common" name="proprietary_vendor_qcom_common" remote="fru" />

  <!-- sm8650 CAF HALs (audio, data, display), forked from LineageOS -->
  <project path="hardware/qcom-caf/sm8650/audio/agm" name="android_vendor_qcom_opensource_agm" remote="fru" revision="calcite-caf-sm8650" />
  <project path="hardware/qcom-caf/sm8650/audio/graphservices" name="android_vendor_qcom_opensource_audioreach-graphservices" remote="fru" revision="calcite-caf-sm8650" />
  <project path="hardware/qcom-caf/sm8650/audio/pal" name="android_vendor_qcom_opensource_arpal-lx" remote="fru" revision="calcite-caf-sm8650" />
  <project path="hardware/qcom-caf/sm8650/audio/primary-hal" name="android_hardware_qcom_audio-ar" remote="fru" revision="calcite-caf-sm8650" />
  <project path="hardware/qcom-caf/sm8650/data-ipa-cfg-mgr" name="android_vendor_qcom_opensource_data-ipa-cfg-mgr" remote="fru" revision="calcite-caf-sm8650" />
  <project path="hardware/qcom-caf/sm8650/dataipa" name="android_vendor_qcom_opensource_dataipa" remote="fru" revision="calcite-caf-sm8650" />
  <project path="hardware/qcom-caf/sm8650/display" name="android_hardware_qcom_display" remote="fru" revision="calcite-caf-sm8650">
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8650/Android.bp" />
  </project>

  <!-- Device bring-up: asteroids (nothing) -->
  <project path="device/nothing/asteroids" name="android_device_nothing_asteroids" remote="fru" />
  <project path="vendor/nothing/asteroids" name="proprietary_vendor_nothing_asteroids" remote="fru" />
  <project path="hardware/nothing" name="android_hardware_nothing" remote="fru" />
  <project path="kernel/nothing/sm7635" name="android_kernel_nothing_sm7635" remote="fru" />
  <project path="kernel/nothing/sm7635-modules" name="android_kernel_nothing_sm7635-modules" remote="fru" />
  <project path="kernel/nothing/sm7635-devicetrees" name="android_kernel_nothing_sm7635-devicetrees" remote="fru" />
  <project path="hardware/dolby" name="hardware_dolby" remote="fru" />
  <project path="packages/apps/DolbyAtmos" name="android_packages_apps_DolbyAtmos" remote="fru" />

</manifest>
